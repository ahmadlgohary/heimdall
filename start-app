#!/bin/sh

sudo dockerd
&
echo "Starting Database"
&
docker run -d --name heimdall-postgres -p 5432:5432 \
  -e POSTGRES_USER=heimdall  \ 
  -e POSTGRES_PASSWORD=heimdall \
  -e POSTGRES_DB=heimdall \
  postgres:latest
&
echo "Starting Rabbitmq"
&
docker run -d --name heimdall-rabbitmq -p 5672:5672 \
  -p 15672:15672 \
  rabbitmq:latest
&
echo "Starting Frontend"
&
npm run dev --prefix frontend
&
echo "Starting Backend"
&
cd backend
&
uv run uvicorn app.main:app --reload --port 8000     # API
&
echo "Starting Outbox Worker"
&
uv run python -m app.workers.outbox_worker           # publisher
&
echo "Starting Deliver Worker"
&
uv run python -m app.workers.delivery_worker         # worker

# Heimdall configuration: the ONE environment file for the whole repo.
#   cp .env.example .env    (or `make env`, which also generates the secrets below)
# Read by: the backend when run directly (uv run ...), docker compose (both files),
# the Makefile, the e2e tests, and `make worker-dev` (which copies WORKER_SHARED_SECRET
# into the Cloudflare Worker's .dev.vars). Never commit .env.

# ---------- runtime ----------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
JSON_LOGS=true

# ---------- database and broker ----------
# Used when running the backend directly and by docker-compose.prod.yml.
# docker-compose.yml (dev) ignores these and uses its own postgres and rabbitmq containers.
# Any postgres:// URL works, including Neon's as copied from its dashboard
# (?sslmode=require&channel_binding=require is translated for asyncpg automatically).
# Neon's pooled ("-pooler") hosts are detected; override with DATABASE_USES_POOLER=true|false.
DATABASE_URL=postgresql+asyncpg://heimdall:heimdall@localhost:5432/heimdall
RABBITMQ_URL=amqp://heimdall:heimdall@localhost:5672/

# ---------- secrets ----------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Encrypts endpoint signing secrets at rest. Required in production.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, list several comma-separated keys: the first encrypts, all of them decrypt.
ENCRYPTION_KEY=
# Shared with the Cloudflare Worker. Empty disables /api/v1/internal/ingest.
WORKER_SHARED_SECRET=

# ---------- payload storage ----------
# s3 | local | memory. "local" writes under LOCAL_STORAGE_PATH (dev only).
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.storage
# Neon object storage or Amazon S3: the four AWS_* names are the ones Neon provides.
# Keep the bucket private.
S3_BUCKET_NAME=
AWS_ENDPOINT_URL_S3=               # Neon's endpoint; leave empty for Amazon S3 itself
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional tuning (rarely needed):
# S3_FORCE_PATH_STYLE=false         # true for MinIO-style path addressing
# S3_SERVER_SIDE_ENCRYPTION=        # AES256 | aws:kms | empty. Default: AES256 on Amazon S3, none on custom endpoints
# S3_KMS_KEY_ID=

# ---------- URLs, CORS and cookies ----------
# Comma-separated list of allowed browser origins (CORS, credentials).
FRONTEND_URL=http://localhost:5173
# Public URL of the API; the worker reaches the demo receiver at API_URL/demo-receiver.
API_URL=http://localhost:8000
# Cross-site deployments (frontend and API on different sites) need
# COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=            # defaults to true in production

# ---------- demo environment ----------
# `make seed` / `python -m app.scripts.seed`. Credentials are shown on the sign-in page.
# docker-compose.yml turns the demo on regardless; opt in here for direct runs and production.
DEMO_ENABLED=false
DEMO_EMAIL=demo@heimdall.dev
DEMO_PASSWORD=DemoPassword123
# Serve the built-in test receiver at /demo-receiver (demo endpoints deliver there).
DEMO_RECEIVER_ENABLED=false
# How the worker reaches it. Default: API_URL + /demo-receiver
DEMO_RECEIVER_URL=

# ---------- delivery ----------
# Lets endpoints target localhost/private IPs (e.g. the mock receiver). Refused in production.
ALLOW_PRIVATE_DESTINATIONS=false
# Single-container MVP: run the outbox publisher inside the API process.
RUN_PUBLISHER_IN_API=false
WORKER_CONCURRENCY=16

# ---------- docker compose ----------
# Credentials for the postgres and rabbitmq containers.
DB_PASSWORD=heimdall
RABBITMQ_USER=heimdall
RABBITMQ_PASSWORD=heimdall
# docker-compose.yml stores payloads locally unless you set this to s3 (uses the S3 settings above).
DEV_STORAGE_BACKEND=local
# Host ports; change them if something else already uses one.
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=8000
FRONTEND_PORT=8080
MOCK_RECEIVER_PORT=9000
# docker-compose.prod.yml: number of delivery workers
WORKER_REPLICAS=2

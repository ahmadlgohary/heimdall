# Heimdall — environment for docker compose (`make env` copies this to .env).
# Never commit .env. Every backend setting is documented in backend/.env.example.

# ---- local infrastructure (docker-compose.yml) ----
DB_PASSWORD=heimdall
RABBITMQ_USER=heimdall
RABBITMQ_PASSWORD=heimdall

# Host ports, change if something else already uses them
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=8000
FRONTEND_PORT=8080
MOCK_RECEIVER_PORT=9000

# ---- application ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
WORKER_SHARED_SECRET=

# local = payloads on a shared docker volume; s3 = Neon object storage / Amazon S3
STORAGE_BACKEND=local
S3_BUCKET_NAME=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Demo account (make seed). Always on in docker-compose.yml; opt in for production.
DEMO_ENABLED=false
DEMO_EMAIL=demo@heimdall.dev
DEMO_PASSWORD=DemoPassword123

# ---- production only (docker-compose.prod.yml) ----
# Neon: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_MIGRATION_URL=
FRONTEND_URL=
# Public URL of the site; the worker reaches the demo receiver at API_URL/demo-receiver
API_URL=

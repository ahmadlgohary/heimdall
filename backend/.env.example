# Copy to .env (or the repo root .env) and fill in. Never commit real values.
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
JSON_LOGS=true

# Any postgres:// URL works, including Neon's as copied from its dashboard
# (?sslmode=require&channel_binding=require is translated for asyncpg automatically).
DATABASE_URL=postgresql+asyncpg://heimdall:heimdall@localhost:5432/heimdall
# Neon: use the pooled ("-pooler") URL above for the app and the direct URL here for migrations.
# Pooled hosts are detected by name; override with DATABASE_USES_POOLER=true|false if needed.
DATABASE_MIGRATION_URL=
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Encrypts endpoint signing secrets at rest. Required in production.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Event payload storage: s3 | local | memory. "local" writes under LOCAL_STORAGE_PATH (dev only).
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.storage

# Object storage (Neon object storage or Amazon S3). These four are the variables Neon provides;
# the names are the standard AWS SDK ones. Keep the bucket private.
S3_BUCKET_NAME=
AWS_ENDPOINT_URL_S3=               # Neon's endpoint; leave empty for Amazon S3 itself
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional tuning (rarely needed):
# S3_FORCE_PATH_STYLE=false         # true for MinIO-style path addressing
# S3_SERVER_SIDE_ENCRYPTION=        # AES256 | aws:kms | empty. Default: AES256 on Amazon S3, none on custom endpoints
# S3_KMS_KEY_ID=

# Shared with the Cloudflare Worker. Empty disables /api/v1/internal/ingest.
WORKER_SHARED_SECRET=

# Comma-separated list of allowed browser origins (CORS, credentials).
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
# Refresh-token cookie. Cross-site deployments (frontend and API on different sites) need
# COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=            # defaults to true in production

# Lets endpoints target localhost/private IPs (e.g. the mock receiver). Refused in production.
ALLOW_PRIVATE_DESTINATIONS=false
# Single-container MVP: run the outbox publisher inside the API process.
RUN_PUBLISHER_IN_API=false
WORKER_CONCURRENCY=16

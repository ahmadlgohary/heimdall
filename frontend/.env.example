# Base URL of the FastAPI backend. Leave empty to use same-origin /api/v1
# (the Vite dev server proxies /api to VITE_DEV_API_PROXY or http://localhost:8000).
VITE_API_URL=

# Serve the in-browser mock API instead of the real backend (dev only).
# `npm run dev:mock` sets this for you.
VITE_API_MOCKING=false

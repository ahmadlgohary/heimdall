# Rendered by the nginx image at startup (envsubst on ${API_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS}).
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Same-origin API proxy, so the refresh-token cookie needs no cross-site settings.
  # Resolved per request: the container still starts when no API host exists
  # (e.g. the image is used as a plain static server).
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $api_upstream ${API_UPSTREAM};

  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    client_max_body_size 1m;
    proxy_read_timeout 30s;
  }

  # Built-in test receiver (demo endpoints deliver here). 404s unless DEMO_RECEIVER_ENABLED.
  location /demo-receiver/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    client_max_body_size 1m;
  }

  # hashed assets can be cached forever
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # single-page app: every other route serves index.html
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
}
